<?xml version="1.0" encoding="UTF-8"?>
<!--
  RotoDesk Windows installer (WiX 3.x).

  Build with installer/build-msi.ps1 (it runs cargo build -release, then
  candle/light). Installs rotodesk.exe under Program Files, adds Start Menu
  and Desktop shortcuts and an Add/Remove Programs entry. Upgrades are
  handled by MajorUpgrade with a stable UpgradeCode; the ProductId is
  regenerated on every build ("*").

  Install options (also settable on the msiexec command line for silent
  installs, e.g. `msiexec /i RotoDesk.msi /qn STARTWITHWINDOWS=0
  INSTALLDESKTOPSHORTCUT=0`):
    STARTWITHWINDOWS       "1" (default) writes the HKCU Run value "RotoDesk"
                           so the app starts at sign-in. The app's own
                           "Start with Windows" setting writes the same value
                           name, so both stay consistent.
    INSTALLDESKTOPSHORTCUT "1" (default) creates the desktop shortcut.
  The interactive UI exposes both on the OptionsDlg page (WixUI_FeatureTree
  with OptionsDlg inserted between the license and the feature tree) and
  offers "Launch RotoDesk" on the exit page.

  The Windows service is not installed by the MSI on purpose: the app installs
  it on demand from Settings → System (UAC prompt), so users who only want the
  interactive mode never get a background service.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:fire="http://schemas.microsoft.com/wix/FirewallExtension"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*"
           Name="RotoDesk"
           Language="1033"
           Codepage="1252"
           Version="$(var.Version)"
           Manufacturer="RotoDesk"
           UpgradeCode="8B1B0E52-6C1D-4F5B-9C8E-3A2D1E7F0C11">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="RotoDesk: fast, lightweight and secure remote desktop"
             Manufacturer="RotoDesk" />

    <MajorUpgrade Schedule="afterInstallExecute" DowngradeErrorMessage="A newer version of RotoDesk is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="rotodesk.ico" SourceFile="$(var.SourceDir)\installer\rotodesk.ico" />
    <Property Id="ARPPRODUCTICON" Value="rotodesk.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/EnriqueGF/RotoDesk" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Install options. Secure="yes" so values passed on the command line
         survive the transition to the elevated server side of the install. -->
    <Property Id="STARTWITHWINDOWS" Value="1" Secure="yes" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="RotoDesk" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="RotoDesk" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="BrandCredits" Guid="*" Win64="yes">
        <File Id="BrandCreditsFile" Name="BRAND.txt" Source="$(var.SourceDir)\crates\gui\assets\BRAND.txt" KeyPath="yes" />
      </Component>
      <Component Id="FontLicense" Guid="*" Win64="yes">
        <File Id="FontLicenseFile" Name="OFL-BarlowCondensed.txt" Source="$(var.SourceDir)\crates\gui\assets\fonts\OFL-BarlowCondensed.txt" KeyPath="yes" />
      </Component>
      <Component Id="MainExecutable" Guid="*" Win64="yes">
        <File Id="rotodesk.exe"
              Source="$(var.SourceDir)\target\release\rotodesk.exe"
              KeyPath="yes" />
        <!-- Transitional SCM lookup: the previous manually installed service
             must stop before its executable is removed by the major upgrade. -->
        <ServiceControl Id="StopLegacyService" Name="CleanDesk" Stop="install" Wait="yes" />
        <!-- Inbound rules so LAN discovery, direct signaling and ICE work
             without a manual firewall prompt. -->
        <fire:FirewallException Id="FwDirect" Name="RotoDesk (direct signaling)"
                                Port="7423" Protocol="tcp" Scope="any" IgnoreFailure="yes" />
        <fire:FirewallException Id="FwIce" Name="RotoDesk (WebRTC)"
                                Port="7424" Protocol="udp" Scope="any" IgnoreFailure="yes" />
        <fire:FirewallException Id="FwMdns" Name="RotoDesk (mDNS)"
                                Port="5353" Protocol="udp" Scope="localSubnet" IgnoreFailure="yes" />
      </Component>
      <Component Id="RelayExecutable" Guid="*" Win64="yes">
        <File Id="rotodesk_relay_server.exe"
              Source="$(var.SourceDir)\target\release\rotodesk-relay-server.exe"
              KeyPath="yes" />
      </Component>
      <Component Id="SignalExecutable" Guid="*" Win64="yes">
        <File Id="rotodesk_signal_server.exe"
              Source="$(var.SourceDir)\target\release\rotodesk-signal-server.exe"
              KeyPath="yes" />
      </Component>
      <!-- Autostart at sign-in for the installing user. Same value name the
           app writes from its own settings page, so toggling either side
           keeps a single entry. -->
      <Component Id="StartWithWindows" Guid="*" Win64="yes">
        <Condition>STARTWITHWINDOWS = "1"</Condition>
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="RotoDesk"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]rotodesk.exe&quot;"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuRotoDesk"
                  Name="RotoDesk"
                  Description="RotoDesk remote desktop"
                  Target="[INSTALLFOLDER]rotodesk.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="rotodesk.ico" />
        <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RotoDesk" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Condition>INSTALLDESKTOPSHORTCUT = "1"</Condition>
        <Shortcut Id="DesktopRotoDesk"
                  Name="RotoDesk"
                  Target="[INSTALLFOLDER]rotodesk.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="rotodesk.ico" />
        <RegistryValue Root="HKCU" Key="Software\RotoDesk" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="RotoDesk" Level="1" Absent="disallow">
      <ComponentRef Id="BrandCredits" />
      <ComponentRef Id="FontLicense" />
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartWithWindows" />
    </Feature>
    <Feature Id="Servers" Title="Signaling server and relay (private / community mode)" Level="1000">
      <ComponentRef Id="RelayExecutable" />
      <ComponentRef Id="SignalExecutable" />
    </Feature>

    <!-- "Launch RotoDesk" checkbox on the exit page. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch RotoDesk" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#rotodesk.exe]" />
    <CustomAction Id="MigrateLegacyService" FileKey="rotodesk.exe" ExeCommand="--migrate-service"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="MigrateLegacyService" After="InstallFiles">NOT REMOVE</Custom>
    </InstallExecuteSequence>
    <CustomAction Id="LaunchRotoDesk"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <UI Id="WixUI_RotoDesk">
      <UIRef Id="WixUI_FeatureTree" />

      <!-- Options page inserted between the license and the feature tree.
           WixUI_FeatureTree publishes LicenseAgreementDlg/Next -> CustomizeDlg
           at Order 2 and CustomizeDlg/Back -> LicenseAgreementDlg; a higher
           Order runs later, so the last NewDialog wins. -->
      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.LicenseAgreementDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Install options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose how RotoDesk integrates with Windows." />

        <Control Id="StartWithWindowsCheck" Type="CheckBox" X="26" Y="70" Width="320" Height="17"
                 Property="STARTWITHWINDOWS" CheckBoxValue="1"
                 Text="&amp;Start RotoDesk when I sign in" />
        <Control Id="StartWithWindowsHelp" Type="Text" X="40" Y="88" Width="310" Height="24" NoPrefix="yes"
                 Text="Keeps the host reachable after a reboot. You can change this later from Settings." />

        <Control Id="DesktopShortcutCheck" Type="CheckBox" X="26" Y="120" Width="320" Height="17"
                 Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1"
                 Text="&amp;Create a desktop shortcut" />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Order="3">LicenseAccepted = "1"</Publish>
      <Publish Dialog="OptionsDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="OptionsDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg">1</Publish>
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="3">NOT Installed</Publish>

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchRotoDesk">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>
    </UI>

    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\installer\license.rtf" />
  </Product>
</Wix>
